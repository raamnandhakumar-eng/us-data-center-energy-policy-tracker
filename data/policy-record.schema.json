{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GridPolicy Policy Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "jurisdiction",
    "region",
    "policyType",
    "status",
    "agency",
    "issueAreas",
    "summary",
    "whyItMatters",
    "businessImpact",
    "teams",
    "recommendedAction",
    "owner",
    "source",
    "sourceConfidence",
    "lastReviewed",
    "evidence",
    "claims"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "region": { "type": "string" },
    "policyType": { "type": "string" },
    "status": { "type": "string" },
    "effectiveDate": { "type": "string" },
    "agency": { "type": "string" },
    "issueAreas": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "whyItMatters": { "type": "string" },
    "businessImpact": {
      "type": "object",
      "required": [
        "powerAvailability",
        "utilityCost",
        "interconnectionTimeline",
        "siteSelection",
        "renewableRequirements",
        "capex",
        "opex",
        "regulatoryUncertainty"
      ],
      "additionalProperties": { "type": "string" }
    },
    "teams": { "type": "array", "items": { "type": "string" } },
    "recommendedAction": {
      "enum": ["Monitor", "Engage", "Analyze", "Escalate", "No action"]
    },
    "owner": { "type": "string" },
    "dueDate": { "type": "string" },
    "sourceConfidence": { "enum": ["High", "Medium"] },
    "lastReviewed": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "sourceLabel", "sourceUrl"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "sourceLabel": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "versionHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "date", "source", "changes"],
        "properties": {
          "label": { "type": "string" },
          "date": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          },
          "changes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["label", "url", "sourceType"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "publishedDate": { "type": "string" },
        "sourceType": { "const": "Primary" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
